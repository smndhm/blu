---
layout: layouts/base.njk
bodyClass: ds-l-page--centered
# <title> de l'accueil, plus descriptif que le seul nom (le h1 reste le nom)
documentTitle: 'Simon Duhem, architecte front-end : accessibilité et Web Components'
---
<div class="ds-c-hero">
<h1 class="ds-c-hero__title">{{ metadata.title }}</h1>
<p class="ds-c-hero__description">{{ metadata.intro }}</p>
<nav class="ds-c-hero__nav" aria-label="Liens">
	<ul class="ds-c-hero__list ds-l-cluster">
		<li class="ds-c-hero__item"><a href="/articles/">Articles</a></li>
		{%- for link in metadata.social %}
		<li class="ds-c-hero__item"><a href="{{ link.url }}">{{ link.name }}</a></li>
		{%- endfor %}
	</ul>
</nav>
</div>

<script type="module" src="/js/lcs-cnvs.js" eleventy:ignore></script>
