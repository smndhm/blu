---
layout: layouts/base.njk
bodyClass: page--home
---
<div class="intro">
<h1 class="intro__title">{{ metadata.title }}</h1>
<p class="intro__description">{{ metadata.description }}</p>
<nav class="intro__nav" aria-label="Liens">
	<ul class="intro__links">
		<li><a href="/articles/">Articles</a></li>
		{%- for link in metadata.social %}
		<li><a href="{{ link.url }}">{{ link.name }}</a></li>
		{%- endfor %}
	</ul>
</nav>
</div>

<script type="module" src="/js/lcs-cnvs.js" eleventy:ignore></script>
