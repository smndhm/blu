---
layout: layouts/base.njk
title: CV
documentTitle: CV de Simon Duhem, architecte front-end
description: CV de Simon Duhem, architecte front-end spécialisé en accessibilité (RGAA, WCAG) et en Web Components, qui conçoit un design system.
---
{#- Contenu : _data/cv.js. Une seule colonne, des sections aux titres classiques et des dates à chaque poste, pour les ATS :
    le PDF (scripts/cv-pdf.js) est cette page imprimée. #}
{%- macro period(start, end) -%}
<time datetime="{{ start }}">{{ start | monthYear }}</time> - {% if end %}<time datetime="{{ end }}">{{ end | monthYear }}</time>{% else %}aujourd'hui{% endif %}
{%- endmacro %}
<h1>{{ metadata.author.name }}</h1>
<p><strong>{{ cv.title }}</strong></p>
<ul class="ds-l-cluster">
	<li><a href="mailto:{{ metadata.author.email }}">{{ metadata.author.email }}</a></li>
	<li><a href="{{ metadata.url }}">{{ metadata.url | replace("https://", "") | replace("/", "") }}</a></li>
	{%- for link in metadata.social %}
	<li><a href="{{ link.url }}">{{ link.url | replace("https://", "") | replace("www.", "") | replace(r/\/$/, "") }}</a></li>
	{%- endfor %}
</ul>
<p class="ds-u-print-hidden"><a href="/cv/simon-duhem-cv.pdf" class="ds-c-button ds-c-button--outline" download>Télécharger le CV (PDF)</a></p>

<h2>Profil</h2>
{#- L'accroche de la page d'accueil #}
<p>{{ metadata.intro }}</p>

<h2>Compétences</h2>
<ul>
	{%- for skill in cv.skills %}
	<li><strong>{{ skill.name }}</strong> : {{ skill.keywords | join(", ") }}</li>
	{%- endfor %}
</ul>

<h2>Expérience professionnelle</h2>
{%- for company in cv.work %}
{%- for job in company.positions %}
<hgroup>
	<h3>{{ job.position }}, {{ company.name }}</h3>
	<p class="ds-c-post__meta"><small>{{ period(job.start, job.end) }}{% if job.location or company.location %}, {{ job.location or company.location }}{% endif %}</small></p>
</hgroup>
{#- Un paragraphe par réalisation #}
{%- for highlight in job.highlights %}
<p>{{ highlight }}</p>
{%- endfor %}
{%- if job.keywords %}
<p>Technologies : {{ job.keywords | join(", ") }}</p>
{%- endif %}
{%- endfor %}
{%- endfor %}

<h2>Formation</h2>
{%- for school in cv.education %}
<hgroup>
	<h3>{{ school.studyType }}</h3>
	<p class="ds-c-post__meta"><small>{{ school.institution }}, {{ period(school.start, school.end) }}</small></p>
</hgroup>
{%- endfor %}

<h2>Langues</h2>
<p>{% for language in cv.languages %}{{ language.language }} ({{ language.fluency }}){% if not loop.last %}, {% endif %}{% endfor %}</p>

<h2>Conférences et articles</h2>
<ul>
	{#- Une ligne par conférence, avec chacun des événements où elle a été donnée #}
	{%- for title, editions in talks | groupby("title") %}
	<li>Conférence "<a href="{{ editions[0].url }}">{{ title }}</a>" : {% for talk in editions %}{{ talk.event }}{% if talk.date %} <small>(<time datetime="{{ talk.date | isoDate }}">{{ talk.date | monthYear }}</time>)</small>{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</li>
	{%- endfor %}
	{%- for post in collections.posts | reverse %}
	{%- if post.data.origin %}
	<li>Article "<a href="{{ post.data.origin.href }}">{{ post.data.title }}</a>", {{ post.data.origin.title }} <small>(<time datetime="{{ post.date | isoDate }}">{{ post.date | monthYear }}</time>)</small></li>
	{%- endif %}
	{%- endfor %}
</ul>
