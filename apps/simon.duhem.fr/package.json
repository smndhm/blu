    "@dume/dev-config": "1.3.0",
    "@dume/ds": "workspace:*",
    "cross-env": "10.1.0",
    "gray-matter": "4.0.3",
    "ia-postrophe": "workspace:*",
    "luxon": "3.7.2",
    "playwright": "1.64.1",
    "prismjs": "1.30.0",
    "zod": "4.6.7",
    "zod-validation-error": "5.0.0"
  },
