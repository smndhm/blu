---
layout: layouts/base.njk
---
<article>
	<header>
		<hgroup>
			<h1>{{ title }}</h1>
			<p class="ds-u-text-muted">
				<time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
				{%- for topic in tags | topics %} · {{ topic }}{% endfor %}
			</p>
			{%- if origin %}
			<p class="ds-u-text-muted">Publié initialement sur <a href="{{ origin.href }}">{{ origin.title }}</a>.</p>
			{%- endif %}
		</hgroup>
	</header>

	<heading-anchors>
		{{ content | safe }}
	</heading-anchors>
</article>
<script type="module" src="{{ assets["/js/heading-anchors.js"] }}"></script>

{%- if collections.posts %}
{%- set previousPost = collections.posts | getPreviousCollectionItem %}
{%- set nextPost = collections.posts | getNextCollectionItem %}
{%- if nextPost or previousPost %}
<nav aria-label="Autres articles">
	<ul class="ds-c-pagination">
		{%- if previousPost %}<li class="ds-c-pagination__item">← Précédent<br> <a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a></li>{% endif %}
		{%- if nextPost %}<li class="ds-c-pagination__item ds-c-pagination__item--next">Suivant →<br><a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a></li>{% endif %}
	</ul>
</nav>
{%- endif %}
{%- endif %}
