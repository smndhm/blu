---
layout: layouts/base.njk
---
{# The article, its previous and next links and the code example components of @dume/ds, only on articles, in the page's CSS bundle #}
<style>
	{% include "node_modules/@dume/ds/dist/components/post.css" %}
	{% include "node_modules/@dume/ds/dist/components/post-nav.css" %}
	{% include "node_modules/@dume/ds/dist/components/code.css" %}
</style>

<article class="ds-c-post">
	<header class="ds-c-post__header">
		<h1 class="ds-c-post__title">{{ title }}</h1>
		<p class="ds-c-post__meta">
			<time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
			{%- for topic in tags | topics %} · {{ topic }}{% endfor %}
		</p>
		{%- if origin %}
		<p class="ds-c-post__meta">Publié initialement sur <a href="{{ origin.href }}">{{ origin.title }}</a>.</p>
		{%- endif %}
	</header>

	<heading-anchors class="ds-c-post__content">
		{{ content | safe }}
	</heading-anchors>
</article>

{%- if collections.posts %}
{%- set previousPost = collections.posts | getPreviousCollectionItem %}
{%- set nextPost = collections.posts | getNextCollectionItem %}
{%- if nextPost or previousPost %}
<nav class="ds-c-post-nav" aria-label="Autres articles">
	<ul class="ds-c-post-nav__list">
		{%- if previousPost %}<li class="ds-c-post-nav__item">← Précédent<br> <a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a></li>{% endif %}
		{%- if nextPost %}<li class="ds-c-post-nav__item ds-c-post-nav__item--next">Suivant →<br><a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a></li>{% endif %}
	</ul>
</nav>
{%- endif %}
{%- endif %}
