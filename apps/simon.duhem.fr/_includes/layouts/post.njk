---
layout: layouts/base.njk
---
{# Only include the syntax highlighter CSS on blog posts, included with the CSS per-page bundle #}
<style>{% include "node_modules/prismjs/themes/prism-okaidia.css" %}</style>
<style>{% include "css/prism-diff.css" %}</style>

<article class="post">
	<header class="post-header">
		<h1>{{ title }}</h1>
		<p class="meta">
			<time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
			{%- for topic in tags | topics %} · {{ topic }}{% endfor %}
		</p>
		{%- if origin %}
		<p class="meta">Publié initialement sur <a href="{{ origin.href }}">{{ origin.title }}</a>.</p>
		{%- endif %}
	</header>

	<heading-anchors>
		{{ content | safe }}
	</heading-anchors>
</article>

{%- if collections.posts %}
{%- set previousPost = collections.posts | getPreviousCollectionItem %}
{%- set nextPost = collections.posts | getNextCollectionItem %}
{%- if nextPost or previousPost %}
<nav aria-label="Autres articles">
	<ul class="links-nextprev">
		{%- if previousPost %}<li class="links-nextprev-prev">← Précédent<br> <a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a></li>{% endif %}
		{%- if nextPost %}<li class="links-nextprev-next">Suivant →<br><a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a></li>{% endif %}
	</ul>
</nav>
{%- endif %}
{%- endif %}
