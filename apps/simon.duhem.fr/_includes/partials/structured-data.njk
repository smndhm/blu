{#- Données structurées schema.org (JSON-LD) : la personne sur l'accueil et sur le CV, l'article sur chaque post #}
{%- set person = {
	"@type": "Person",
	"name": metadata.author.name,
	"url": metadata.author.url,
	"jobTitle": metadata.author.jobTitle,
	"knowsAbout": metadata.author.knowsAbout,
	"sameAs": metadata.social | pluck("url")
} %}
{%- if page.url == "/" %}
<script type="application/ld+json">{{ {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	"url": metadata.url,
	"inLanguage": metadata.language,
	"description": metadata.description,
	"mainEntity": person
} | jsonLd | safe }}</script>
{%- elif page.url == cv.url %}
{#- La même personne, avec ce que dit le CV : l'entreprise du poste en cours, les écoles, les langues #}
{%- set employer = cv.work[0] %}
<script type="application/ld+json">{{ {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	"url": page.url | htmlBaseUrl(metadata.url),
	"inLanguage": metadata.language,
	"description": description,
	"mainEntity": person | merge({
		"worksFor": { "@type": "Organization", "name": employer.name } if not employer.positions[0].end,
		"alumniOf": cv.education | pluck("institution") | organizations("EducationalOrganization"),
		"knowsLanguage": cv.languages | pluck("language")
	})
} | jsonLd | safe }}</script>
{%- elif layout == "layouts/post.njk" %}
<script type="application/ld+json">{{ {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": title,
	"description": description,
	"datePublished": page.date | isoDate,
	"inLanguage": metadata.language,
	"url": page.url | htmlBaseUrl(metadata.url),
	"image": ogImageUrl | htmlBaseUrl(metadata.url) if ogImageUrl,
	"keywords": tags | topics,
	"isBasedOn": origin.href if origin,
	"author": person
} | jsonLd | safe }}</script>
{%- endif %}
