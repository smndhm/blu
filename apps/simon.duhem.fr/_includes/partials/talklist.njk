<ul class="list" role="list">
{%- for talk in talks %}
	<li class="list-item">
		<h{{ headingLevel }} class="list-title"><a href="{{ talk.url }}">{{ talk.title }}</a></h{{ headingLevel }}>
		<p class="meta">
			{%- if talk.eventUrl %}<a href="{{ talk.eventUrl }}">{{ talk.event }}</a>{% else %}{{ talk.event }}{% endif %}
			{%- if talk.date %} · <time datetime="{{ talk.date | isoDate }}">{{ talk.date | readableDate }}</time>{% endif %}
			{%- if talk.author %} · {{ talk.author }}{% endif %}
		</p>
		{%- if showDescription and talk.description %}
		<p>{{ talk.description }}</p>
		{%- endif %}
		<p class="meta">
			Télécharger&nbsp;:
			{%- for file in talk.downloads %} <a href="{{ file.url }}" download>{{ file.format | upper }}<span class="visually-hidden"> — {{ talk.title }}, {{ talk.event }}</span></a>{% if not loop.last %},{% endif %}{% endfor %}
		</p>
	</li>
{%- endfor %}
</ul>
