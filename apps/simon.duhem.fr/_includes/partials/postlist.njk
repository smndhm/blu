<ul class="list" role="list">
{%- for post in posts %}
	<li class="list-item">
		<h{{ headingLevel }} class="list-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h{{ headingLevel }}>
		<p class="meta">
			<time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
			{%- for topic in post.data.tags | topics %} · {{ topic }}{% endfor %}
		</p>
	</li>
{%- endfor %}
</ul>
