<ul class="ds-l-stack" role="list">
{%- for item in items %}
	<li>
		<hgroup>
			<h2><a href="{{ item.url }}">{{ item.title }}</a></h2>
			<p class="ds-u-text-muted">
			{%- if item.date %}<time datetime="{{ item.date | isoDate }}">{{ item.date | readableDate }}</time> · {% endif %}
			{%- if item.isTalk %}
			Conférence à {% if item.eventUrl %}<a href="{{ item.eventUrl }}">{{ item.event }}</a>{% else %}{{ item.event }}{% endif %}
			{%- else %}
			Article{% for topic in item.topics | topics %} · {{ topic }}{% endfor %}
			{%- endif %}
		</p>
		</hgroup>
		{%- if item.description %}
		<p>{{ item.description }}</p>
		{%- endif %}
		{%- if item.isTalk %}
		<p class="ds-u-text-muted"><a href="{{ item.pdf }}" download>Télécharger les slides en PDF<span class="ds-u-visually-hidden"> - {{ item.title }}, {{ item.event }}</span></a></p>
		{%- endif %}
	</li>
{%- endfor %}
</ul>
