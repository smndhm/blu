{
  "name": "@dume/webcomp-utils",
  "version": "1.0.1",
  "main": "dist/webcomp-utils.umd.js",
  "module": "dist/webcomp-utils.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "description": "Deep DOM and Shadow DOM selectors for Web Components. Traverse all open shadow roots with standard CSS selectors.",
  "author": "Simon Duhem",
  "keywords": [
    "web-components",
    "shadow-dom",
    "custom-elements",
    "querySelector",
    "webcomp-utils",
    "dom",
    "javascript",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smndhm/blu.git",
    "directory": "packages/webcomp-utils"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "doc": "typedoc --plugin typedoc-plugin-markdown && mv docs/README.md ./README.md",
    "prepublishOnly": "pnpm doc && pnpm build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.3"
  }
}
