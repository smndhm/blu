{
  "name": "blu",
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.10.0",
  "scripts": {
    "postinstall": "manypkg check",
    "build": "turbo build",
    "test": "turbo run test",
    "manypkg:fix": "manypkg fix",
    "lint:style": "stylelint '**/*.{scss,css}' --ignore-path .gitignore --allow-empty-input",
    "lint:prettier": "prettier . --check",
    "lint:eslint": "eslint .",
    "lint": "pnpm lint:style && pnpm lint:prettier && pnpm lint:eslint",
    "lint:fix": "pnpm lint:style --fix && pnpm lint:prettier --write && pnpm lint:eslint --fix",
    "changeset:add": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "changeset:renovate": "changesets-renovate",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,json,md,mjs}": [
      "prettier **/*.{js,json,md,mjs} --write",
      "eslint **/*.{js,json,md,mjs} --fix"
    ],
    "**/*.{scss,css}": "pnpm lint:style"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@dume/linting": "workspace:*",
    "@eslint/compat": "2.1.1",
    "@manypkg/cli": "0.25.1",
    "@scaleway/changesets-renovate": "4.0.4",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "turbo": "2.11.7"
  }
}
